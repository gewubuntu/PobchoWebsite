---

<section class="consent" data-consent hidden aria-labelledby="consent-title" aria-describedby="consent-text">
  <h2 class="h5 consent__title" id="consent-title">Cookies &amp; Analytics</h2>
  <p class="font--small" id="consent-text">
    We would like to use Google Analytics to understand how visitors use this site. It sets cookies and sends usage data
    to Google. Analytics only runs if you accept, and you can change your choice anytime via “Cookie settings” at the
    bottom of the page.
  </p>
  <div class="consent__actions">
    <button class="button button--blue" type="button" data-consent-choice="granted">Accept</button>
    <button class="button button--blue" type="button" data-consent-choice="denied">Decline</button>
  </div>
</section>

<script>
  import { initConsent } from "../scripts/consent";
  initConsent();
</script>

<style lang="scss">
  @use "../styles/tools" as *;

  .consent {
    background: var(--poncho_blue_dark);
    border: 2px solid var(--poncho_white);
    border-radius: var(--radius-card);
    bottom: 30px;
    box-shadow: var(--glow-orange);
    left: 30px;
    max-width: 560px;
    padding: 25px 30px;
    position: fixed;
    z-index: 3000;

    &[hidden] {
      display: none;
    }

    p {
      line-height: 1.4rem;
    }
  }

  .consent__title {
    line-height: 1.5rem;
    margin-bottom: 10px;
  }

  .consent__actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;

    .button {
      flex: 1;
      margin: 0;
    }
  }

  @include media("lg") {
    .consent {
      bottom: 20px;
      left: 20px;
      right: 20px;
      max-width: none;
      padding: 20px;
    }
  }

  @include media("sm") {
    .consent {
      bottom: 15px;
      left: 15px;
      right: 15px;
    }
  }
</style>
