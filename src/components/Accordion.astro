---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  open?: boolean;
  class?: string;
}

const { title, open = false, class: className } = Astro.props;
---

<details class:list={["accordion", className]} open={open}>
  <summary class="accordion__trigger">
    <span class="accordion__title">{title}</span>
    <Icon name="fa6-solid:chevron-down" class="icon accordion__chevron" aria-hidden="true" />
  </summary>
  <div class="accordion__panel">
    <slot />
  </div>
</details>

<style lang="scss">
  @use "../styles/tools" as *;

  .accordion {
    margin: 20px 0;
    text-align: left;
  }

  .accordion__trigger {
    align-items: center;
    background: var(--poncho_blue);
    border: 2px solid var(--poncho_white);
    border-radius: 50px;
    cursor: pointer;
    display: flex;
    font-weight: 600;
    gap: 10px;
    justify-content: space-between;
    list-style: none;
    padding: 20px;
    transition: background-color 150ms $ease;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      background: var(--poncho_blue_hover);
    }
  }

  .accordion[open] .accordion__trigger {
    font-weight: 700;
  }

  .accordion__chevron {
    transition: transform 150ms $ease;
  }

  .accordion[open] .accordion__chevron {
    transform: rotate(180deg);
  }

  .accordion__panel {
    background: var(--poncho_blue_dark);
    border: 2px solid var(--poncho_white);
    border-bottom-left-radius: var(--radius-card);
    border-bottom-right-radius: var(--radius-card);
    border-top: 0;
    line-height: 25px;
    margin: 0 auto;
    padding: 20px;
    width: 95%;

    > :global(:last-child) {
      margin-bottom: 0;
    }
  }

  @media (hover: none) {
    .accordion__trigger:hover {
      background: var(--poncho_blue);
    }
  }

  @include media("xs") {
    .accordion__panel {
      width: 90%;
    }
  }
</style>
