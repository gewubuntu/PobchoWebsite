---
import { Picture } from "astro:assets";
import background from "../assets/img/background.png";
---

<Picture
  class="page-background"
  src={background}
  alt=""
  widths={[800, 1600, 2400]}
  sizes="100vw"
  formats={["avif"]}
  fallbackFormat="webp"
  quality={40}
  loading="eager"
  decoding="async"
  aria-hidden="true"
/>

<style>
  .page-background {
    height: 100%;
    inset: 0;
    object-fit: cover;
    opacity: 0.1;
    pointer-events: none;
    position: fixed;
    width: 100%;
    z-index: -1;
  }
</style>
